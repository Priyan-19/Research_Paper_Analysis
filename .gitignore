# ==============================================================================
# Git Ignore Configuration — LLM + Knowledge Graph Research Assistant
# Supports: Python FastAPI Backend + React Vite Frontend + Docker DB Services
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python & Backend Cache / Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.uv/
.cache/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
coverage/
*/coverage/
htmlcov/
*.cover
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 2. Node.js & React Frontend Artifacts & Vitest Coverage
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
dist/
dist-ssr/
*/dist/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache

# ------------------------------------------------------------------------------
# 3. Environment Variables & Secrets (NEVER commit secrets or API keys)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# ------------------------------------------------------------------------------
# 4. Database, PDF Uploads, Processed Chunks & Benchmark Outputs
# ------------------------------------------------------------------------------
data/uploads/*
!data/uploads/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/evaluation/benchmark_results.json
backend/data/uploads/*
!backend/data/uploads/.gitkeep
backend/data/processed/*
!backend/data/processed/.gitkeep
backend/data/evaluation/benchmark_results.json
*.sqlite3
*.db

# Docker persistent volumes (if mounted locally)
postgres_data/
neo4j_data/
redis_data/

# ------------------------------------------------------------------------------
# 5. Build & Packaging Artifacts
# ------------------------------------------------------------------------------
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# 6. IDEs, Editors & Tooling
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# Legacy Streamlit artifacts
.streamlit/
backend/.streamlit/

# ------------------------------------------------------------------------------
# 7. Operating System Artifacts
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ------------------------------------------------------------------------------
# 8. Logs & Temporary Scratch Files
# ------------------------------------------------------------------------------
*.log
logs/
scratch/
tmp/
temp/
