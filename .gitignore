# ==============================================================================
# Git Ignore Configuration — LLM + Knowledge Graph Research Assistant
# Supports: Python FastAPI Backend + React Vite Frontend + Docker DB Services
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python & Backend Cache / Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
.uv/
.cache/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 2. Node.js & React Frontend Artifacts
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
dist/
dist-ssr/
*/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache

# ------------------------------------------------------------------------------
# 3. Environment Variables & Secrets (NEVER commit secrets or API keys)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# ------------------------------------------------------------------------------
# 4. Database, PDF Uploads & Processed Chunks
# ------------------------------------------------------------------------------
data/uploads/*
!data/uploads/.gitkeep
data/processed/*
!data/processed/.gitkeep
backend/data/uploads/*
!backend/data/uploads/.gitkeep
backend/data/processed/*
!backend/data/processed/.gitkeep
*.sqlite3
*.db

# Docker volumes (if mounted locally)
postgres_data/
neo4j_data/
redis_data/

# ------------------------------------------------------------------------------
# 5. Build & Packaging Artifacts
# ------------------------------------------------------------------------------
build/
*.egg-info/
.eggs/

# ------------------------------------------------------------------------------
# 6. IDEs, Editors & Tooling
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# Legacy Streamlit artifacts
.streamlit/
backend/.streamlit/

# ------------------------------------------------------------------------------
# 7. Operating System Artifacts
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ------------------------------------------------------------------------------
# 8. Logs & Temporary Scratch Files
# ------------------------------------------------------------------------------
*.log
logs/
scratch/
tmp/
temp/
